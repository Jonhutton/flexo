# Copy to .env and fill in, or set these in your shell/session.
# Flexo reads them from the environment — keys are never written to config.yaml.

# Required: Claude API (pick recommendations + Flexo persona)
ANTHROPIC_API_KEY=

# Optional: ElevenLabs TTS. If unset, Flexo falls back to free edge-tts.
ELEVENLABS_API_KEY=

# Optional: override the Arena Player.log location (else auto-detected).
# MTGA_LOG=C:\Users\Jonhu\AppData\LocalLow\Wizards Of The Coast\MTGA\Player.log
